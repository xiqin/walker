# Feishu credentials
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=replace-with-your-app-secret

# Feishu behavior
FEISHU_ROUTE_MODE=thread
FEISHU_PROGRESS_STYLE=card
FEISHU_REACTION_EMOJI=OnIt
FEISHU_DONE_EMOJI=

# Walker runtime
WALKER_DATA_DIR=
WALKER_DEFAULT_AGENT=opencode
WALKER_DEFAULT_RUNTIME=windows
WALKER_DEFAULT_CWD=H:\walker
WALKER_WSL_DISTRO=Ubuntu-24.04
WALKER_DEDUP_WINDOW_MS=300000

# Walker admin UI
WALKER_ADMIN_ENABLED=true
WALKER_ADMIN_HOST=127.0.0.1
WALKER_ADMIN_PORT=8787
WALKER_ADMIN_TOKEN=

# Walker logging
WALKER_LOG_LEVEL=info
WALKER_LOG_FILE=false

# Prompt heartbeat / timeout recovery
WALKER_PROMPT_HEARTBEAT_INITIAL_MS=30000
WALKER_PROMPT_HEARTBEAT_INTERVAL_MS=60000
WALKER_PROMPT_HEARTBEAT_STUCK_MS=300000
WALKER_MAX_TURN_TIME_MINS=0

# OpenCode server / CLI
OPENCODE_SERVER_URL=http://localhost:4096
OPENCODE_SERVER_AUTOSTART=true
OPENCODE_CMD=opencode
OPENCODE_MODEL=
OPENCODE_AGENT=
OPENCODE_CONFIG_DIR=

# OpenCode polling / transport timeouts
OPENCODE_POLL_INTERVAL=500
OPENCODE_MAX_POLLS=20
OPENCODE_PROMPT_TIMEOUT_MS=120000
OPENCODE_PROMPT_REQUEST_TIMEOUT_MS=30000
OPENCODE_SSE_OPEN_TIMEOUT_MS=1000
OPENCODE_SSE_IDLE_TIMEOUT_MS=300000
OPENCODE_RECOVERY_WINDOW_MS=300000
OPENCODE_MESSAGE_POLL_INTERVAL_MS=3000
OPENCODE_TUI_LEASE_TIMEOUT_MS=90000
OPENCODE_TUI_HEARTBEAT_INTERVAL_MS=30000

# OpenCode hook / health behavior
WALKER_OPENCODE_HOOK_ENABLED=true
WALKER_OPENCODE_HEALTH_POLL_INTERVAL_MS=5000
WALKER_OPENCODE_EXIT_ACTION=cancel
WALKER_OPENCODE_NON_FOCUS_OUTPUT=true

# Optional local tool overrides
WALKER_SQLITE_CMD=
SQLITE3_PATH=
XDG_STATE_HOME=
